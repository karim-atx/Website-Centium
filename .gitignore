node_modules
dist
*.tsbuildinfo
.DS_Store

# Wrangler's local state and build cache (wrangler pages dev / dev): recreated on
# every run, never committed.
.wrangler/

# environment variables — never commit real values.
# .env.* deliberately covers every suffix (.production, .staging, .development
# and anything else someone invents) rather than listing them; .env itself
# needs its own line because the glob requires a dot after "env".
.env
.env.*
!.env.example

# editor/OS cruft
.vscode/*
!.vscode/extensions.json
.idea
Thumbs.db

# local Claude Code tooling config — hardcodes this machine's paths
.claude/

# staging area for design handoffs and other drop-in material —
# never meant to be committed, just read and applied
scratchpad/

# the Supabase CLI's scratch directory, created by `npm run gen:types`. It
# holds a cached project ref and nothing worth keeping.
supabase/.temp/
design-handover/

# Round E: the on-device lab report reader, copied from node_modules by
# vite.config.ts (ocrFiles) whenever dev or build starts. Never committed.
public/ocr/
