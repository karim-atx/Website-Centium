# Copy this file to .env.local and fill in real values locally. .env.local is
# git-ignored — never commit it. See SECURITY.md for what's safe to put
# here versus what must stay server-side.
#
# Only ever put publishable/anon keys here, never a service-role or secret
# key: this app ships as a static bundle, so anything matching an exposed env
# prefix is compiled into the public JavaScript and readable by anyone. The
# exposed prefixes are VITE_ and NEXT_PUBLIC_ (see envPrefix in vite.config.ts).

# --- Supabase -------------------------------------------------------------
# Two credential pairs, one per environment; lib/supabase/config.ts picks the
# active pair from NEXT_PUBLIC_APP_ENV. Values come from the Supabase
# dashboard: Project Settings -> API -> Project URL + anon/public key.

NEXT_PUBLIC_SUPABASE_URL_STAGING=
NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGING=
NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=

# Which pair the app uses: "staging" (default) or "prod".
NEXT_PUBLIC_APP_ENV=staging
